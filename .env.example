# ---------------------------------------------------------------------------
# PKIMonitor configuration. Copy to ".env" and adjust.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ---- General ----
APP_NAME=PKIMonitor
DEBUG=false
LOG_LEVEL=INFO

# ---- Frontend ----
# Host port the web UI is served on (docker compose) and Vite dev/preview port.
# If you change this, add http://localhost:<port> to CORS_ORIGINS below.
FRONTEND_PORT=8080

# ---- Database ----
# SQLite (default) or e.g. postgresql+psycopg://user:pw@db:5432/pkimonitor
DATABASE_URL=sqlite:///./data/pkimonitor.db

# ---- API security ----
# Leave empty to disable auth. If set, write requests need header X-API-Key.
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ---- Scheduler ----
MONITOR_INTERVAL_HOURS=6
ALERT_INTERVAL_HOURS=24
RUN_CHECKS_ON_STARTUP=false
SSL_TIMEOUT_SECONDS=10

# ---- Alert thresholds (days before expiry, comma separated) ----
ALERT_THRESHOLDS=60,30,7

# ---- Email (SMTP) ----
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=pkimonitor@example.com
SMTP_TO=ops@example.com,security@example.com

# ---- Webhook (Slack / Teams / generic) ----
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_TYPE=slack
